+    private static int spoofSystemProperties() {
+        final Map<String, String> props = new LinkedHashMap<>(sPifSystemProps);
+        props.putIfAbsent("init.svc.adbd", "stopped");
+        props.putIfAbsent("sys.usb.state", "mtp");
+        final String initialSdk = sPifBuildFields.get("DEVICE_INITIAL_SDK_INT");
+        putPropIfPresent(props, "ro.board.first_api_level", initialSdk);
+        putPropIfPresent(props, "ro.product.first_api_level", initialSdk);
+        putPropIfPresent(props, "ro.build.fingerprint", sPifBuildFields.get("FINGERPRINT"));
+        putPropIfPresent(props, "ro.build.id", sPifBuildFields.get("ID"));
+        putPropIfPresent(props, "ro.product.device", sPifBuildFields.get("DEVICE"));
+        putPropIfPresent(props, "ro.product.name", sPifBuildFields.get("PRODUCT"));
+        putPropIfPresent(props, "ro.product.brand", sPifBuildFields.get("BRAND"));
+        putPropIfPresent(props, "ro.product.model", sPifBuildFields.get("MODEL"));
+        final String securityPatch = sPifBuildFields.get("SECURITY_PATCH");
+        putPropIfPresent(props, "ro.build.version.security_patch", securityPatch);
+        putPropIfPresent(props, "ro.vendor.build.security_patch", securityPatch);
+        putPropIfPresent(props, "ro.system.build.security_patch", securityPatch);
+
+        final String[] keys = props.keySet().toArray(new String[0]);
+        final String[] values = props.values().toArray(new String[0]);
+        try {
+            if (nativeSpoofProperties(keys, values, sPifVerboseLogs > 0)) {
+                return keys.length;
+            }
+            Log.w(TAG, "Property area virtualization failed");
+        } catch (Throwable t) {
+            Log.e(TAG, "Failed to spoof system properties", t);
+        }
+        return 0;
+    }
