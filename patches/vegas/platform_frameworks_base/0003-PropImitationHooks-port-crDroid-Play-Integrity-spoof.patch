+    /** brand/product/device:release/id/incremental:type/tags */
+    private static void expandFingerprint(String fingerprint) {
+        final List<String> parts = new ArrayList<>();
+        final StringBuilder current = new StringBuilder();
+        for (int i = 0; i < fingerprint.length(); i++) {
+            final char ch = fingerprint.charAt(i);
+            if (ch == '/' || ch == ':') {
+                parts.add(current.toString());
+                current.setLength(0);
+            } else {
+                current.append(ch);
+            }
+        }
+        parts.add(current.toString());
+
+        final String[] keys = {
+            "BRAND", "PRODUCT", "DEVICE", "RELEASE", "ID", "INCREMENTAL", "TYPE", "TAGS"
+        };
+        for (int i = 0; i < keys.length && i < parts.size(); i++) {
+            String val = parts.get(i);
+            if (val.isEmpty()) continue;
+            // A Canary fingerprint carries "CANARY" where the release goes; keep ours.
+            if ("RELEASE".equals(keys[i]) && "CANARY".equalsIgnoreCase(val)) continue;
+            sPifBuildFields.put(keys[i], val);
+        }
+    }
