+    private static void processPifKeyValue(String key, String value) {
+        if (key.startsWith("VERSION.")) {
+            key = key.substring(8);
+        }
+        switch (key) {
+            case "verboseLogs":
+            case "VERBOSE_LOGS":
+                try {
+                    sPifVerboseLogs = Integer.parseInt(value);
+                } catch (NumberFormatException e) {
+                    sPifVerboseLogs = 0;
+                }
+                break;
+            case "DEBUG":
+                if (isTrue(value) && sPifVerboseLogs == 0) sPifVerboseLogs = 1;
+                break;
+            case "spoofBuild":
+                sPifSpoofBuild = isTrue(value);
+                break;
+            case "spoofProps":
+                sPifSpoofProps = isTrue(value);
+                break;
+            case "spoofVendingBuild":
+                sPifSpoofVendingBuild = isTrue(value);
+                break;
+            case "spoofVendingSdk":
+                sPifSpoofVendingSdk = isTrue(value);
+                break;
+            case "spoofProvider":
+            case "spoofSignature":
+            case "spoofVendingFinger":
+                // Key attestation is refused for DroidGuard unconditionally (see
+                // onEngineGetCertificateChain); signature spoofing is not ported.
+                break;
+            case "DEVICE_INITIAL_SDK_INT":
+                sPifDeviceInitialSdkInt = value;
+                break;
+            default:
+                if (key.contains(".") || key.startsWith("*")) {
+                    sPifSystemProps.put(key, value);
+                } else {
+                    sPifBuildFields.put(key, value);
+                }
+                break;
+        }
+    }
