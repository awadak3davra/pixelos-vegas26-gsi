@@ -41,6 +50,9 @@ public final class AttestationService extends SystemService {
 
     private static final String DATA_FILE = "gms_certified_props.json";
 
+    private static final String PROCESS_GMS_UNSTABLE = "com.google.android.gms.unstable";
+    private static final String PACKAGE_FINSKY = "com.android.vending";
+
     private static final long INITIAL_DELAY = 0;
     private static final long INTERVAL = 5;
 
@@ -65,11 +77,59 @@ public final class AttestationService extends SystemService {
         if (!sDisableGmsProps && CustomUtils.isPackageInstalled(mContext, "com.google.android.gms")
                 && phase == PHASE_BOOT_COMPLETED) {
             Log.i(TAG, "Scheduling the service");
+            registerPifObserver();
             mScheduler.scheduleAtFixedRate(
                     new FetchGmsCertifiedProps(), INITIAL_DELAY, INTERVAL, TimeUnit.MINUTES);
         }
     }
 
+    /**
+     * The certified props are applied when a target process starts, so restart DroidGuard
+     * and the Play Store whenever the effective config changes (crDroid AxSpoofManager).
+     */
+    private void registerPifObserver() {
+        final ContentResolver resolver = mContext.getContentResolver();
+        final ContentObserver observer = new ContentObserver(BackgroundThread.getHandler()) {
+            @Override
+            public void onChange(boolean selfChange, Uri uri) {
+                final String key = uri == null ? null : uri.getLastPathSegment();
+                if (key == null) return;
+                if (Settings.Secure.FETCHED_PIF.equals(key) && !TextUtils.isEmpty(
+                        Settings.Secure.getString(resolver, Settings.Secure.PIF_DATA))) {
+                    dlog("Fetched props changed, user PIF data still in effect");
+                    return;
+                }
+                Log.i(TAG, "PIF config changed (" + key + "), restarting target processes");
+                restartPifTargets();
+            }
+        };
+        for (String key : new String[] {
+                Settings.Secure.PIF_DATA, Settings.Secure.FETCHED_PIF }) {
+            resolver.registerContentObserver(Settings.Secure.getUriFor(key), false, observer,
+                    UserHandle.USER_ALL);
+        }
+    }
+
+    private void restartPifTargets() {
+        try {
+            final ActivityManager am = mContext.getSystemService(ActivityManager.class);
+            final List<ActivityManager.RunningAppProcessInfo> procs =
+                    am == null ? null : am.getRunningAppProcesses();
+            if (procs == null) return;
+            for (ActivityManager.RunningAppProcessInfo proc : procs) {
+                final String name = proc.processName;
+                if (name == null) continue;
+                if (name.equals(PROCESS_GMS_UNSTABLE) || name.equals(PACKAGE_FINSKY)
+                        || name.startsWith(PACKAGE_FINSKY + ":")) {
+                    Log.i(TAG, "Killing " + name + " (pid " + proc.pid + ")");
+                    Process.killProcess(proc.pid);
+                }
+            }
+        } catch (Throwable t) {
+            Log.w(TAG, "Failed to restart PIF target processes", t);
+        }
+    }
+
