# vegas26: Android Open Accessory needs Google VID/PID after ACCESSORY_START.
# Stock sets them in Motorola's /system_ext/etc/init/hw/init.usb.rc (imported by the
# vendor init.mt6835.usb.rc), which a GSI does not have. Without it the gadget stays
# 22b8:2e81, head units (e.g. Toyota) never find the accessory and reset the port.
# The MTK gadget HAL sets vendor.usb.config first; init.mmi.usb.configfs.rc then copies
# it to sys.usb.config, whose actions bind the UDC. Writing here, on vendor.usb.config,
# happens while the UDC is still unbound.
on property:vendor.usb.config=accessory && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x2d00

on property:vendor.usb.config=accessory,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x2d01

on property:vendor.usb.config=audio_source && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x2d02

on property:vendor.usb.config=audio_source,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x2d03

on property:vendor.usb.config=accessory,audio_source && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x2d04

on property:vendor.usb.config=accessory,audio_source,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x2d05
